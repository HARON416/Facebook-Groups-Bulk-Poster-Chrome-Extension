{
  "manifest_version": 3,
  "name": "Postika – Facebook Groups Auto Poster",
  "short_name": "Postika",
  "version": "1.6.44",
  "description": "Post to Facebook Groups in three simple steps: create your post, select groups, then review and post.",
  "icons": {
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "key": "",
  "action": {
    "default_title": "Open Postika"
  },
  "permissions": [
    "sidePanel",
    "cookies",
    "storage",
    "alarms",
    "scripting",
    "webRequest"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://web.facebook.com/*",
    "https://upload.facebook.com/*"
  ],
  "background": {
    "service_worker": "dist/service-worker.js"
  }
}
