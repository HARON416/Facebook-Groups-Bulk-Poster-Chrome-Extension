{
  "manifest_version": 3,
  "name": "Facebook Groups Bulk Poster",
  "version": "1.5.0",
  "description": "Bulk post to Facebook groups with images, custom delays, live progress, and optional Gemini rewrites.",
  "icons": {
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "action": {
    "default_title": "Open Facebook Groups Bulk Poster"
  },
  "permissions": [
    "sidePanel",
    "tabs",
    "cookies",
    "storage",
    "scripting",
    "webRequest"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "host_permissions": [
    "https://api.facebook-groups-bulk-poster.softwrhq.com/*",
    "https://www.facebook.com/*",
    "https://web.facebook.com/*",
    "https://upload.facebook.com/*"
  ],
  "background": {
    "service_worker": "dist/service-worker.js"
  }
}
